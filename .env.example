# =============================================================================
# Mecanico - variables de l'infrastructure Docker
# -----------------------------------------------------------------------------
#   cp .env.example .env      (puis adapter si besoin)
#
# Le fichier .env est ignoré par Git : ne jamais le committer.
# Sans .env, docker-compose.yml utilise les valeurs par défaut ci-dessous.
# =============================================================================

# --- Profils lancés par défaut avec "docker compose up" ----------------------
# Vide      : uniquement l'infrastructure commune (MySQL, MongoDB, RabbitMQ,
#             Keycloak, Eureka, API Gateway). Chacun lance son MS dans son IDE.
# ms1,ms3   : infrastructure + les microservices choisis (dans Docker).
# all       : toute la plateforme, Front-end compris (démo / soutenance).
COMPOSE_PROFILES=

# --- Fuseau horaire -----------------------------------------------------------
TZ=Africa/Tunis

# --- MySQL (une base par microservice) ----------------------------------------
MYSQL_ROOT_PASSWORD=root
DB_USER=mecanico
DB_PASSWORD=mecanico
MYSQL_PORT=3307

# --- MongoDB (MS5) -------------------------------------------------------------
MONGO_PORT=27017

# --- RabbitMQ (communication asynchrone) ----------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Keycloak (realm "mecanico") -------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# --- Spring Cloud ---------------------------------------------------------------
EUREKA_PORT=8761
GATEWAY_PORT=8084

# --- Microservices ----------------------------------------------------------------
MARKETPLACE_PORT=8081
PASSPORT_PORT=8082

# --- Front-end (profil "front" ou "all") ------------------------------------------
FRONTEND_PORT=4201

# --- Limites mémoire (adapter à sa machine ; total "all" ~ 6 Go) ------------------
MEM_MYSQL=768m
MEM_MONGO=512m
MEM_RABBITMQ=384m
MEM_KEYCLOAK=1g
MEM_SPRING_INFRA=384m
MEM_SPRING_SERVICE=512m
MEM_FRONTEND=64m
